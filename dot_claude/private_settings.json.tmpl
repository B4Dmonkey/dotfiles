{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  {{- if eq .machine "jw"}}
  "env": {
    "ANTHROPIC_AUTH_TOKEN": {{.anthropicAuthToken | quote}},
    "ANTHROPIC_BASE_URL": {{.anthropicBaseUrl | quote}},
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": {{.claudeCodeDisableExperimentalBetas | quote}}
  },
  {{- end}}
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(*.env)",
      "Read(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(git restore *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git branch -D *)",
      "Bash(npx *)",
      "Bash(npm exec *)",
      "Bash(bunx *)",
      "Bash(pnpm dlx *)",
      "Bash(yarn dlx *)"
    ]
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir'); dir_name=$(basename \"$cwd\"); status=\"$(printf '\\033[96m%s\\033[0m' \"$dir_name\")\"; if git -C \"$cwd\" rev-parse --git-dir > /dev/null 2>&1; then branch=$(git -C \"$cwd\" rev-parse --abbrev-ref HEAD 2>/dev/null); [ -n \"$branch\" ] && status+=\" $(printf '\\033[2;37m[%s]\\033[0m' \"$branch\")\"; git_status=$(git -C \"$cwd\" --no-optional-locks status --porcelain 2>/dev/null); if [ -n \"$git_status\" ]; then modified=$(echo \"$git_status\" | grep -c '^ M' || true); untracked=$(echo \"$git_status\" | grep -c '^??' || true); staged=$(echo \"$git_status\" | grep -c '^[AMDRC]' || true); indicators=\"\"; [ \"$modified\" -gt 0 ] && indicators+=\"​\"; [ \"$untracked\" -gt 0 ] && indicators+=\"​\"; [ \"$staged\" -gt 0 ] && indicators+=\"​\"; [ -n \"$indicators\" ] && status+=\" $(printf '\\033[38;5;218m%s\\033[0m' \"$indicators\")\"; fi; fi; [ -n \"$VIRTUAL_ENV\" ] && status+=\" $(printf '\\033[2;37m%s\\033[0m' \"$(basename \"$VIRTUAL_ENV\")\")\"; echo \"$status\""
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "ai@pydantic-skills": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "pydantic-skills": {
      "source": {
        "source": "github",
        "repo": "pydantic/skills"
      }
    },
    "go-skills": {
      "source": {
        "source": "github",
        "repo": "spf13/go-skills"
      }
    },
    "bit-pro": {
      "source": {
        "source": "github",
        "repo": "B4Dmonkey/bit-pro"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "theme": "dark-ansi",
  "editorMode": "normal",
  "autoCompactEnabled": true
}
